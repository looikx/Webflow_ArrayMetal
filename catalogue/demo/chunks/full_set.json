forated Metal\", category: \"Industrial & Architectural\", blurb: \"Perforated panels for industrial and architectural applications.\", image: IMG.perforated, systems: [] }\n];\nconst SYSTEMS = {\naml: {\nid: \"aml\", group: \"cable-ladders\", name: \"AML Cable Ladder System\",\nshort: \"NEMA VE1 heavy-duty ladder series for industrial and infrastructure cabling.\",\nimage: IMG.aml, standard: \"NEMA VE1-2009\", safety: \"×1.5\",\nmaterials: [\"HDG\", \"SS304\", \"SS316\", \"Aluminium\"],\nheights: \"100 / 125 / 150 mm\", widths: \"150–900 mm\",\noverview: \"AML is Array Metal’s NEMA VE1 cable ladder system for medium to heavy cable support. Models cover NEMA load classes with published safe working loads by span (3 m, 4.5 m, 6 m).\",\ndesign: [\n{ t: \"Heights\", d: \"AML100, AML125 and AML150 side-rail heights for load depth and future expansion.\" },\n{ t: \"Widths\", d: \"Typical widths 150, 300, 450, 600, 750 and 900 mm.\" },\n{ t: \"Standards\", d: \"Tested to NEMA VE1-2009 with safety factor ×1.5.\" },\n{ t: \"Finishes\", d: \"Hot-dip galvanized (BS EN ISO 1461), stainless steel and aluminium options.\" }\n]\n},\napo: {\nid: \"apo\", group: \"cable-ladders\", name: \"APO Cable Ladder System\",\nshort: \"SIRIM / NEMA ladder series with verified span load performance.\",\nimage: IMG.apo, standard: \"SIRIM / NEMA VE1-2009\", safety: \"×1.5\",\nmaterials: [\"HDG\", \"SS304\", \"SS316\"],\nheights: \"100 / 125 / 150 mm\", widths: \"150–900 mm\",\noverview: \"APO cable ladders combine SIRIM and NEMA VE1 testing for projects requiring documented load performance across standard support spans.\",\ndesign: [\n{ t: \"Heights\", d: \"APO100, APO125 and APO150 models.\" },\n{ t: \"Testing\", d: \"SIRIM / NEMA VE1-2009, safety factor ×1.5.\" },\n{ t: \"Spans\", d: \"Published SWL at 3 m, 4.5 m and 6 m.\" },\n{ t: \"Finishes\", d: \"HDG, stainless and coated options.\" }\n]\n},\nacd: {\nid: \"acd\", group: \"cable-ladders\", name: \"ACD Cable Ladder System\",\nshort: \"IEC 