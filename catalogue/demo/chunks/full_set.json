() {\nsetNav(\"home\");\nreturn `\n<div class=\"breadcrumb\"><span>Products</span></div>\n<h1 class=\"page-title\">Products</h1>\n<p class=\"page-intro\">Browse Array Metal cable support systems and engineered products. Select a product group to explore systems, components and technical data.</p>\n<div class=\"group-grid\">\n${GROUPS.map((g) => `\n<button type=\"button\" class=\"group-card\" data-go=\"group/${g.id}\">\n<div class=\"thumb\"><img src=\"${esc(g.image)}\" alt=\"\" loading=\"lazy\" /></div>\n<div class=\"body\">\n<div class=\"meta\">${esc(g.category)}</div>\n<h2>${esc(g.name)}</h2>\n<p>${esc(g.blurb)}</p>\n</div>\n</button>\n`).join(\"\")}\n</div>\n`;\n}\nfunction renderGroup(groupId) {\nconst g = groupById(groupId);\nif (!g) return renderHome();\nsetNav(groupId === \"cable-ladders\" || groupId === \"cable-trays\" ? groupId : \"home\");\nif (!g.systems.length) {\nreturn `\n<div class=\"breadcrumb\">\n<a href=\"#/\" data-go=\"home\">Products</a> / <span>${esc(g.name)}</span>\n</div>\n<h1 class=\"page-title\">${esc(g.name)}</h1>\n<p class=\"page-intro\">${esc(g.blurb)}</p>\n<div class=\"empty-state\">System pages for this group will be expanded next — structure matches Cable Ladders / Cable Trays.</div>\n`;\n}\nconst systems = g.systems.map((id) => SYSTEMS[id]).filter(Boolean);\nreturn `\n<div class=\"breadcrumb\">\n<a href=\"#/\" data-go=\"home\">Products</a> / <span>${esc(g.name)}</span>\n</div>\n<h1 class=\"page-title\">${esc(g.name)}</h1>\n<p class=\"page-intro\">${esc(g.blurb)}</p>\n<div class=\"system-list\">\n${systems.map((s) => `\n<button type=\"button\" class=\"system-card\" data-go=\"system/${s.id}\">\n<div class=\"thumb\"><img src=\"${esc(s.image)}\" alt=\"\" loading=\"lazy\" /></div>\n<div class=\"body\">\n<h2>${esc(s.name)}</h2>\n<p>${esc(s.short)}</p>\n<div class=\"tags\">\n<span class=\"pill\">${esc(s.standard)}</span>\n<span class=\"pill\">SF ${esc(s.safety)}</span>\n</div>\n</div>\n</button>\n`).join(\"\")}\n</div>\n`;\n}\nfunction filterArticles(list) {\nconst { systems, types, q } = state.filters;\nreturn list.filter((a) => {\nif (systems.size && !systems.has(a.sys)) return false;\nif (types.size && !types.has(a.type)) return false;\nif (q) {\nconst hay = (a.name + \" \" + a.code + \" \" + a.type + \" \" + a.sys).toLowerCase();\nif (!hay.includes(q.toLowerCase())) return false;\n}\nreturn true;\n});\n}\nfunction countBy(list, key) {\nconst m = {};\nlist.forEach((a) => { m[a[key]] = (m[a[key]] || 0) + 1; });\nreturn m;\n}\nfunction renderSystem(sysId) {\nconst s = SYSTEMS[sysId];\nif (!s) return renderHome();\nconst g = groupById(s.group);\nsetNav(s.group);\nconst all = articlesForSystem(sysId);\nconst filtered = filterArticles(all);\nconst bySys = countBy(all, \"sys\");\nconst byType = countBy(all, \"type\");\nconst sysKeys = Object.keys(bySys).sort();\nconst typeKeys = Object.keys(byType).sort();\nconst hasFilters = state.filters.systems.size || state.filters.types.size || state.filters.q;\nreturn `\n<div class=\"breadcrumb\">\n<a href=\"#/\" data-go=\"home\">Products</a> /\n<a href=\"#/${esc(s.group)}\" data-go=\"group/${esc(s.group)}\">${esc(g?.name || s.group)}</a> /\n<span>${esc(s.name)}</span>\n</div>\n<h1 class=\"page-title\">${esc(s.name)}</h1>\n<p class=\"page-intro\">${esc(s.overview)}</p>\n<div class=\"system-layout\">\n<aside class=\"filter-panel\">\n<div class=\"filter-head\">\n<h3>Filter products</h3>\n<button type=\"button\" class=\"filter-clear\" id=\"clear-filters\" ${hasFilters ? \"\" : \"disabled\"}>Clear all</button>\n</div>\n<div class=\"filter-section\">\n<h4>System</h4>\n${sysKeys.map((k) => `\n<label class=\"filter-option\">\n<input type=\"checkbox\" data-filter=\"sys\" value=\"${esc(k)}\" ${state.filters.systems.has(k) ? \"checked\" : \"\"} />\n<span>${esc(k)}</span>\n<span class=\"count\">(${bySys[k]})</span>\n</label>\n`).join(\"\")}\n</div>\n<div class=\"filter-section\">\n<h4>Product type</h4>\n${typeKeys.map((k) => `\n<label class=\"filter-option\">\n<input type=\"checkbox\" data-filter=\"type\" value=\"${esc(k)}\" ${state.filters.types.has(k) ? \"checked\" : \"\"} />\n<span>${esc(k)}</span>\n<span class=\"count\">(${byType[k]})</span>\n</label>\n`).join(\"\")}\n</div>\n<div class=\"filter-section\">\n<h4>Search</h4>\n<input class=\"filter-search\" id=\"filter-q\" type=\"search\" placeholder=\"Name or code…\" value=\"${esc(state.filters.q)}\" />\n</div>\n</aside>\n<div>\n<div class=\"results-bar\">\n<div class=\"count\"><strong>${filtered.length}</strong> results</div>\n<div class=\"active-filters\" id=\"active-filters\">\n${[...state.filters.systems].map((k) => `<span class=\"chip\">${esc(k)} <button type=\"button\" data-remove-sys=\"${esc(k)}\" aria-label=\"Remove\">×</button></span>`).join(\"\")}\n${[...state.filters.types].map((k) => `<span class=\"chip\">${esc(k)} <button type=\"button\" data-remove-type=\"${esc(k)}\" aria-label=\"Remove\">×</button></span>`).join(\"\")}\n${state.filters.q ? `<span class=\"chip\">“${esc(state.filters.q)}” <button type=\"button\" data-remove-q aria-label=\"Remove\">×</button></span>` : \"\"}\n</div>\n</div>\n${filtered.length ? `\n<div class=\"article-grid\">\n${filtered.map((a) => `\n<button type=\"button\" class=\"article-card\" data-go=\"article/${a.id}\">\n<div class=\"thumb\"><img src=\"${esc(a.image)}\" alt=\"\" loading=\"lazy\" /></div>\n<div class=\"body\">\n<h3>${esc(a.name)}</h3>\n<p class=\"sub\">${esc(a.code)} · ${esc(a.type)}</p>\n</div>\n</button>\n`).join(\"\")}\n</div>\n` : `<div class=\"empty-state\">No products match these filters.</div>`}\n<div class=\"content-block\">\n<h2>System overview</h2>\n<p>${esc(s.overview)}</p>\n<div class=\"link-row\">\n<span class=\"pill\">${esc(s.standard)}</span>\n<span class=\"pill\">Safety factor ${esc(s.safety)}</span>\n<span class=\"pill\">Heights ${esc(s.heights)}</span>\n<span class=\"pill\">Widths ${esc(s.widths)}</span>\n</div>\n</div>\n<div class=\"content-block\">\n<h2>Design details</h2>\n<div class=\"design-grid\">\n${s.design.map((d) => `\n<div class=\"design-item\">\n<h3>${esc(d.t)}</h3>\n<p>${esc(d.d)}</p>\n</div>\n`).join(\"\")}\n</div>\n</div>\n<div class=\"content-block\">\n<h2>Materials</h2>\n<div class=\"link-row\">\n${s.materials.map((m) => `<a class=\"link-pill\" href=\"https://www.arraymetal.com/materials\" target=\"_blank\" rel=\"noopener\">${esc(m)}</a>`).join(\"\")}\n</div>\n</div>\n<div class=\"content-block\">\n<h2>Downloads & load data</h2>\n<div class=\"link-row\">\n<a class=\"link-pill is-primary\" href=\"https://www.arraymetal.com/load-ratings\" target=\"_blank\" rel=\"noopener\">Load ratings (SWL tables)</a>\n<a class=\"link-pill\" href=\"https://www.arraymetal.com/catalogue\" target=\"_blank\" rel=\"noopener\">Catalogues</a>\n</div>\n</div>\n</div>\n</div>\n`;\n}\nfunction renderArticle(id) {\nconst a = ARTICLES.find((x) => x.id === id);\nif (!a) return renderHome();\nconst s = SYSTEMS[a.system];\nconst g = groupById(s.group);\nsetNav(s.group);\nconst related = ARTICLES.filter((x) => x.system === a.system && x.id !== a.id).slice(0, 4);\nreturn `\n<div class=\"breadcrumb\">\n<a href=\"#/\" data-go=\"home\">Products</a> /\n<a href=\"#/${esc(s.group)}\" data-go=\"group/${esc(s.group)}\">${esc(g?.name)}</a> /\n<a href=\"#/system/${esc(s.id)}\" data-go=\"system/${esc(s.id)}\">${esc(s.name)}</a> /\n<span>${esc(a.name)}</span>\n</div>\n<h1 class=\"page-title\">${esc(a.name)}</h1>\n<div class=\"article-layout\">\n<div>\n<div class=\"article-media\">\n<img src=\"${esc(a.image)}\" alt=\"${esc(a.name)}\" />\n</div>\n</div>\n<div>\n<div class=\"article-meta\">\n<span>${esc(a.code)}</span>\n<span>${esc(a.type)}</span>\n<span>${esc(a.sys)}</span>\n</div>\n<p style=\"margin:0 0 8px;color:var(--body)\">${esc(s.short)}</p>\n<div class=\"section-label\">Characteristics</div>\n<table class=\"char-table\">\n<tbody>\n${a.chars.map(([k, v]) => `<tr><th>${esc(k)}</th><td>${esc(v)}</td></tr>`).join(\"\")}\n</tbody>\n</table>\n<div class=\"link-row\" style=\"margin-top:20px\">\n<a class=\"link-pill is-primary\" href=\"https://www.arraymetal.com/load-ratings\" target=\"_blank\" rel=\"noopener\">Load ratings</a>\n<a class=\"link-pill\" href=\"https://www.arraymetal.com/contact-us\" target=\"_blank\" rel=\"noopener\">Contact sales</a>\n<button type=\"button\" class=\"link-pill\" data-go=\"system/${esc(s.id)}\">Back to ${esc(s.name)}</button>\n</div>\n<div class=\"variant-note\">\nConfigure length, width and finish when requesting a quote (Phase 2 inquiry list). This page is technical reference only.\n</div>\n</div>\n</div>\n${related.length ? `\n<div class=\"content-block\">\n<h2>Related products</h2>\n<div class=\"related-grid\">\n${related.map((r) => `\n<button type=\"button\" class=\"article-card\" data-go=\"article/${r.id}\">\n<div class=\"thumb\"><img src=\"${esc(r.image)}\" alt=\"\" loading=\"lazy\" /></div>\n<div class=\"body\">\n<h3>${esc(r.name)}</h3>\n<p class=\"sub\">${esc(r.code)}</p>\n</div>\n</button>\n`).join(\"\")}\n</div>\n</div>\n` : \"\"}\n`;\n}\nconst app = document.getElementById(\"app\");\nfunction render() {\nconst route = parseHash();\nif (route.page === \"system\" || route.page === \"group\") {\n}\nif (route.page === \"home\") {\nstate.filters = { systems: new Set(), types: new Set(), q: \"\" };\napp.innerHTML = renderHome();\n} else if (route.page === \"group\") {\nstate.filters = { systems: new Set(), types: new Set(), q: \"\" };\napp.innerHTML = renderGroup(route.id);\n} else if (route.page === \"system\") {\napp.innerHTML = renderSystem(route.id);\nbindSystemFilters(route.id);\n} else if (route.page === \"article\") {\napp.innerHTML = renderArticle(route.id);\n} else {\napp.innerHTML = renderHome();\n}\nbindNav();\nwindow.scrollTo(0, 0);\n}\nfunction bindNav() {\napp.querySelectorAll(\"[data-go]\").forEach((el) => {\nel.addEventListener(\"click\", (e) => {\ne.preventDefault();\nconst path = el.getAttribute(\"data-go\");\nif (path === \"home\") go(\"\");\nelse go(path);\n});\n});\n}\nfunction bindSystemFilters(sysId) {\napp.querySelectorAll('input[data-filter=\"sys\"]').forEach((input) => {\ninput.addEventListener(\"change\", () => {\nif (input.checked) state.filters.systems.add(input.value);\nelse state.filters.systems.delete(input.value);\napp.innerHTML = renderSystem(sysId);\nbindSystemFilters(sysId);\nbindNav();\n});\n});\napp.querySelectorAll('input[data-filter=\"type\"]').forEach((input) => {\ninput.addEventListener(\"change\", () => {\nif (input.checked) state.filters.types.add(input.value);\nelse state.filters.types.delete(input.value);\napp.innerHTML = renderSystem(sysId);\nbindSystemFilters(sysId);\nbindNav();\n});\n});\nconst q = document.getElementById(\"filter-q\");\nif (q) {\nq.addEventListener(\"input\", () => {\nstate.filters.q = q.value;\nconst pos = q.selectionStart;\napp.innerHTML = renderSystem(sysId);\nbindSystemFilters(sysId);\nbindNav();\nconst nq = document.getElementById(\"filter-q\");\nif (nq) { nq.focus(); nq.setSelectionRange(pos, pos); }\n});\n}\ndocument.getElementById(\"clear-filters\")?.addEventListener(\"click\", () => {\nstate.filters = { systems: new Set(), types: new Set(), q: \"\" };\napp.innerHTML = renderSystem(sysId);\nbindSystemFilters(sysId);\nbindNav();\n});\napp.querySelectorAll(\"[data-remove-sys]\").forEach((btn) => {\nbtn.addEventListener(\"click\", () => {\nstate.filters.systems.delete(btn.getAttribute(\"data-remove-sys\"));\napp.innerHTML = renderSystem(sysId);\nbindSystemFilters(sysId);\nbindNav();\n});\n});\napp.querySelectorAll(\"[data-remove-type]\").forEach((btn) => {\nbtn.addEventListener(\"click\", () => {\nstate.filters.types.delete(btn.getAttribute(\"data-remove-type\"));\napp.innerHTML = renderSystem(sysId);\nbindSystemFilters(sysId);\nbindNav();\n});\n});\napp.querySelectorAll(\"[data-remove-q]\").forEach((btn) => {\nbtn.addEventListener(\"click\", () => {\nstate.filters.q = \"\";\napp.innerHTML = renderSystem(sysId);\nbindSystemFilters(sysId);\nbindNav();\n});\n});\n}\nwindow.addEventListener(\"hashchange\", render);\ndocument.querySelectorAll(\".top-nav a, .brand\").forEach((a) => {\na.addEventListener(\"click\", (e) => {\nconst route = a.getAttribute(\"data-route\");\nif (!route) return;\ne.preventDefault();\nif (route === \"home\") go(\"\");\nelse go(route);\n});\n});\nrender();\n})();\n</script>\n"}}]}]}}],"context":"Wire full catalogue hierarchy into draft HtmlEmbed for first review"}