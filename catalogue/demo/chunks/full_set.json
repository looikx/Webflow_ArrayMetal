ow:hidden;}#am-cat .system-card .thumb img{width:100%;height:100%;object-fit:contain;padding:16px;background:#fff;}#am-cat .system-card .body{padding:16px 18px 18px;}#am-cat .system-card h2{margin:0 0 6px;font-size:17px;font-weight:650;}#am-cat .system-card p{margin:0;font-size:13.5px;color:var(--body);}#am-cat .system-card .tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px;}#am-cat .pill{font-size:11px;font-weight:600;padding:3px 8px;background:var(--soft);color:var(--body);border:1px solid var(--line);}#am-cat .system-layout{display:grid;grid-template-columns:240px minmax(0,1fr);gap:28px;align-items:start;margin-top:8px;}@media (max-width:900px){#am-cat .system-layout{grid-template-columns:1fr;}}#am-cat .filter-panel{border:1px solid var(--line);background:#fff;position:sticky;top:16px;}#am-cat .filter-head{display:flex;align-items:center;justify-content:space-between;padding:14px 16px;border-bottom:1px solid var(--line);background:var(--soft);}#am-cat .filter-head h3{margin:0;font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;color:var(--ink);}#am-cat .filter-clear{background:none;border:none;color:var(--blue);font-size:12px;font-weight:600;cursor:pointer;padding:0;}#am-cat .filter-clear:disabled{color:var(--muted);cursor:default;}#am-cat .filter-section{padding:14px 16px;border-bottom:1px solid var(--line);}#am-cat .filter-section:last-child{border-bottom:none;}#am-cat .filter-section h4{margin:0 0 10px;font-size:13px;font-weight:700;color:var(--ink);}#am-cat .filter-option{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--body);padding:4px 0;cursor:pointer;user-select:none;}#am-cat .filter-option input{accent-color:var(--navy);width:15px;height:15px;}#am-cat .filter-option .count{margin-left:auto;color:var(--muted);font-size:12px;}#am-cat .filter-search{width:100%;padding:8px 10px;border:1px solid var(--line);background:#fff;font-size:13px;}#am-cat .filter-search:focus{outline:2px solid rgba(24,95,165,0.25);border-color:var(--blue);}#am-cat .results-bar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px;flex-wrap:wrap;}#am-cat .results-bar .count{font-size:14px;color:var(--body);}#am-cat .results-bar .count strong{color:var(--ink);font-weight:700;}#am-cat .active-filters{display:flex;flex-wrap:wrap;gap:6px;}#am-cat .chip{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:600;padding:4px 8px 4px 10px;background:var(--soft);border:1px solid var(--line);color:var(--body);}#am-cat .chip button{border:none;background:none;color:var(--muted);cursor:pointer;padding:0 2px;font-size:14px;line-height:1;}#am-cat .article-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:16px;}#am-cat .article-card{border:1px solid var(--line);background:#fff;cursor:pointer;text-align:left;padding:0;display:flex;flex-direction:column;transition:border-color 0.15s,box-shadow 0.15s;color:inherit;}#am-cat .article-card:hover{border-color:#c5ced9;box-shadow:0 4px 14px rgba(15,23,42,0.05);}#am-cat .article-card .thumb{aspect-ratio:1;background:#fafbfc;border-bottom:1px solid var(--line);display:grid;place-items:center;padding:16px;}#am-cat .article-card .thumb img{max-height:100%;width:auto;max-width:100%;object-fit:contain;}#am-cat .article-card .body{padding:12px 14px 14px;}#am-cat .article-card h3{margin:0;font-size:14px;font-weight:650;line-height:1.35;color:var(--ink);}#am-cat .article-card .sub{margin:4px 0 0;font-size:12px;color:var(--muted);}#am-cat .empty-state{border:1px dashed var(--line);padding:40px 20px;text-align:center;color:var(--muted);background:var(--soft);}#am-cat .content-block{margin-top:48px;padding-top:36px;border-top:1px solid var(--line);}#am-cat .content-block h2{margin:0 0 12px;font-size:22px;font-weight:650;letter-spacing:-0.02em;}#am-cat .content-block > p{margin:0 0 20px;max-width:720px;color:var(--body);}#am-cat .design-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax