{"page_id":"6a71fa9149bd0b583281bdf3","location":"footer","content":"<!-- Array Metal catalogue demo Phase 1 — draft /demo-product-catalogue only -->\n\n<div id=\"am-cat\">\n<div class=\"demo-note\">\n    DRAFT · Oglaend-style hierarchy prototype · not live products · do not publish until approved\n  </div>\n\n  <header class=\"topbar\">\n    <div class=\"topbar-inner\">\n      <a class=\"brand\" href=\"#/\" data-route=\"home\">\n        <span class=\"brand-mark\">AM</span>\n        Array Metal\n      </a>\n      <nav class=\"top-nav\">\n        <a href=\"#/\" data-route=\"home\" class=\"is-active\">Products</a>\n        <a href=\"#/cable-ladders\" data-route=\"cable-ladders\">Cable Ladders</a>\n        <a href=\"#/cable-trays\" data-route=\"cable-trays\">Cable Trays</a>\n      </nav>\n    </div>\n  </header>\n\n  <main class=\"wrap\" id=\"app\"></main>\n</div>\n<script>\n(function () {\n  /* ========== DATA (mirrors Oglaend depth + Array Metal content) ========== */\n  const IMG = {\n    ladder: \"https://cdn.prod.website-files.com/6082b5dc0898b132f7e4fb7f/60c2fa4aef13dc0f0c635ffa_Cable-Ladder-Body.jpg.jpg\",\n    tray: \"https://cdn.prod.website-files.com/6082b5dc0898b132f7e4fb7f/60b70ba32a3003184411aa0d_1.jpg\",\n    trunking: \"https://cdn.prod.website-files.com/6082b5dc0898b132f7e4fb7f/60b724218a42db518a5b7ad6_1.jpg\",\n    wire: \"https://cdn.prod.website-files.com/6082b5dc0898b132f7e4fb7f/60b72513039fa486cd623908_1.jpg\",\n    cleats: \"https://cdn.prod.website-files.com/6082b5dc0898b132f7e4fb7f/69bb945774c2eb60d272d775_2.png\",\n    perforated: \"https://cdn.prod.website-files.com/6082b5dc0898b132f7e4fb7f/60c70cecbaea9cab1930042b_R15T20.jpg\",\n    aml: \"https://cdn.prod.website-files.com/6082b5dc0898b132f7e4fb7f/69c49a5cd41c8600f8100647_AML150%20(2).png\",\n    acd: \"https://cdn.prod.website-files.com/6082b5dc0898b132f7e4fb7f/69c49a642e48de9de6432097_ACD150%20(2).png\",\n    apo: \"https://cdn.prod.website-files.com/6082b5dc0898b132f7e4fb7f/69c64ff30f7d41049d65c516_Array%20Products%20.png\",\n    art: \"https://cdn.prod.website-files.com/6082b5dc0898b132f7e4fb7f/69c4b1607c4274729029111a_ART50.png\",\n    body: \"https://cdn.prod.website-files.com/6082b5dc0898b132f7e4fb7f/60c2f9a9ef063ee6848184d6_Cable%20Ladder%20Body.jpg.png\",\n    cross: \"https://cdn.prod.website-files.com/6082b5dc0898b132f7e4fb7f/60c2f9a9de926fd429ae8bfe_Horizontal%20Equal%20Cross.jpg\",\n    riser: \"https://cdn.prod.website-files.com/6082b5dc0898b132f7e4fb7f/60c2f9a97cf1c2bd0557aca0_Inside%20Riser%2090.jpg\",\n    reducer: \"https://cdn.prod.website-files.com/6082b5dc0898b132f7e4fb7f/60c2f9a95177cbb157b44265_Left%20Reducer.jpg\",\n    tee: \"https://cdn.prod.website-files.com/6082b5dc0898b132f7e4fb7f/60c2f9a9b353232c73aacf10_Unequal%20Tee.jpg\",\n    outside: \"https://cdn.prod.website-files.com/6082b5dc0898b132f7e4fb7f/60c2f9a9b3f5501e2835789e_Outside%20Riser%2090.jpg\",\n    cert: \"https://cdn.prod.website-files.com/6082b5dc0898b132f7e4fb7f/60939dca6be20a7f9c6d444e_SIRIM%20Test%20Report%20Cable%20Ladder.png\"\n  };\n\n  const GROUPS = [\n    { id: \"cable-ladders\", name: \"Cable Ladders\", category: \"Cable Support System\", blurb: \"Medium to heavy duty cable ladder systems tested to NEMA and IEC standards, with full fittings ranges.\", image: IMG.ladder, systems: [\"aml\", \"apo\", \"acd\"] },\n    { id: \"cable-trays\", name: \"Cable Trays\", category: \"Cable Support System\", blurb: \"Light to medium cable tray systems for efficient support where ladder depth is not required.\", image: IMG.tray, systems: [\"art\", \"amt\"] },\n    { id: \"cable-trunking\", name: \"Cable Trunking\", category: \"Cable Support System\", blurb: \"Rectangular trunking for enclosed cable routes.\", image: IMG.trunking, systems: [] },\n    { id: \"wire-trays\", name: \"Wire Trays\", category: \"Cable Support System\", blurb: \"Open wire mesh trays for ventilation and flexible routing.\", image: IMG.wire, systems: [] },\n    { id: \"cable-cleats\", name: \"Cable Cleats\", category: \"Cable Support System\", blurb: \"Cable retention and short-circuit protection.\", image: IMG.cleats, systems: [] },\n    { id: \"perforated\", name: \"Perforated Metal\", category: \"Industrial & Architectural\", blurb: \"Perforated panels for industrial and architectural applications.\", image: IMG.perforated, systems: [] }\n  ];\n\n  const SYSTEMS = {\n    aml: {\n      id: \"aml\", group: \"cable-ladders\", name: \"AML Cable Ladder System\",\n      short: \"NEMA VE1 heavy-duty ladder series for industrial and infrastructure cabling.\",\n      image: IMG.aml, standard: \"NEMA VE1-2009\", safety: \"×1.5\",\n      materials: [\"HDG\", \"SS304\", \"SS316\", \"Aluminium\"],\n      heights: \"100 / 125 / 150 mm\", widths: \"150–900 mm\",\n      overview: \"AML is Array Metal’s NEMA VE1 cable ladder system for medium to heavy cable support. Models cover NEMA load classes with published safe working loads by span (3 m, 4.5 m, 6 m).\",\n      design: [\n        { t: \"Heights\", d: \"AML100, AML125 and AML150 side-rail heights for load depth and future expansion.\" },\n        { t: \"Widths\", d: \"Typical widths 150, 300, 450, 600, 750 and 900 mm.\" },\n        { t: \"Standards\", d: \"Tested to NEMA VE1-2009 with safety factor ×1.5.\" },\n        { t: \"Finishes\", d: \"Hot-dip galvanized (BS EN ISO 1461), stainless steel and aluminium options.\" }\n      ]\n    },\n    apo: {\n      id: \"apo\", group: \"cable-ladders\", name: \"APO Cable Ladder System\",\n      short: \"SIRIM / NEMA ladder series with verified span load performance.\",\n      image: IMG.apo, standard: \"SIRIM / NEMA VE1-2009\", safety: \"×1.5\",\n      materials: [\"HDG\", \"SS304\", \"SS316\"],\n      heights: \"100 / 125 / 150 mm\", widths: \"150–900 mm\",\n      overview: \"APO cable ladders combine SIRIM and NEMA VE1 testing for projects requiring documented load performance across standard support spans.\",\n      design: [\n        { t: \"Heights\", d: \"APO100, APO125 and APO150 models.\" },\n        { t: \"Testing\", d: \"SIRIM / NEMA VE1-2009, safety factor ×1.5.\" },\n        { t: \"Spans\", d: \"Published SWL at 3 m, 4.5 m and 6 m.\" },\n        { t: \"Finishes\", d: \"HDG, stainless and coated options.\" }\n      ]\n    },\n    acd: {\n      id: \"acd\", group: \"cable-ladders\", name: \"ACD Cable Ladder System\",\n      short: \"IEC 61537 ladder series with ×1.7 safety factor.\",\n      image: IMG.acd, standard: \"IEC 61537:2006\", safety: \"×1.7\",\n      materials: [\"HDG\", \"SS304\", \"SS316\"],\n      heights: \"100 / 125 / 150 mm\", widths: \"150–900 mm\",\n      overview: \"ACD ladders are tested to IEC 61537 (certificate 2018MA0594-ACD-IEC61537) for projects specifying IEC compliance.\",\n      design: [\n        { t: \"Standard\", d: \"IEC 61537:2006, safety factor ×1.7.\" },\n        { t: \"Models\", d: \"ACD100, ACD125, ACD150.\" },\n        { t: \"Certificate\", d: \"2018MA0594-ACD-IEC61537.\" },\n        { t: \"Spans\", d: \"SWL published for 3 m, 4.5 m and 6 m.\" }\n      ]\n    },\n    art: {\n      id: \"art\", group: \"cable-trays\", name: \"ART Cable Tray System\",\n      short: \"Light cable tray (ART50) with NEMA load ratings.\",\n      image: IMG.art, standard: \"NEMA VE1-2009\", safety: \"×1.5\",\n      materials: [\"HDG\", \"SS304\", \"SS316\"],\n      heights: \"50 mm\", widths: \"100–600 mm\",\n      overview: \"ART50 is a light cable tray series designed for lighter cable runs with published NEMA SWL at 1.5 m, 2 m and 3 m spans.\",\n      design: [\n        { t: \"Height\", d: \"50 mm loading depth.\" },\n        { t: \"Class\", d: \"NEMA 20AA (ART50).\" },\n        { t: \"Spans\", d: \"SWL at 1.5 m / 2 m / 3 m.\" },\n        { t: \"Use\", d: \"Light electrical and instrumentation routes.\" }\n      ]\n    },\n    amt: {\n      id: \"amt\", group: \"cable-trays\", name: \"AMT Cable Tray System\",\n      short: \"Medium-duty cable tray with NEMA 20B performance.\",\n      image: IMG.tray, standard: \"NEMA VE1-2009\", safety: \"×1.5\",\n      materials: [\"HDG\", \"SS304\", \"SS316\"],\n      heights: \"100 mm\", widths: \"100–600 mm\",\n      overview: \"AMT100 provides higher tray capacity where light ART systems are not sufficient, with published NEMA load data.\",\n      design: [\n        { t: \"Height\", d: \"100 mm loading depth.\" },\n        { t: \"Class\", d: \"NEMA 20B (AMT100).\" },\n        { t: \"Spans\", d: \"SWL at 1.5 m / 2 m / 3 m.\" },\n        { t: \"Finishes\", d: \"HDG, stainless, aluminium options.\" }\n      ]\n    }\n  };\n\n  /* Articles live under a system — filtered by system height + product type (Oglaend model) */\n  const ARTICLES = [\n    /* AML system parts */\n    { id: \"aml-str\", system: \"aml\", name: \"Cable ladder straight section\", type: \"Cable ladder\", sys: \"AML\", image: IMG.body, code: \"AML-STR\",\n      chars: [[\"Type\", \"Cable ladder\"], [\"Series\", \"AML\"], [\"Heights\", \"100 / 125 / 150 mm\"], [\"Widths\", \"150–900 mm\"], [\"Lengths\", \"3 m, 6 m\"], [\"Standard\", \"NEMA VE1-2009\"], [\"Safety factor\", \"×1.5\"], [\"Materials\", \"HDG, SS304, SS316\"]] },\n    { id: \"aml100\", system: \"aml\", name: \"Cable ladder AML100\", type: \"Cable ladder\", sys: \"AML100\", image: IMG.aml, code: \"AML100\",\n      chars: [[\"Model\", \"AML100\"], [\"Height\", \"100 mm\"], [\"Loading depth\", \"75 mm\"], [\"Thickness\", \"1.5 / 2 mm\"], [\"SWL @ 3 m\", \"192 kg/m\"], [\"SWL @ 4.5 m\", \"85 kg/m\"], [\"SWL @ 6 m\", \"48 kg/m\"], [\"NEMA class\", \"20AA\"], [\"Standard\", \"NEMA VE1-2009\"]] },\n    { id: \"aml125\", system: \"aml\", name: \"Cable ladder AML125\", type: \"Cable ladder\", sys: \"AML125\", image: IMG.aml, code: \"AML125\",\n      chars: [[\"Model\", \"AML125\"], [\"Height\", \"125 mm\"], [\"Loading depth\", \"100 mm\"], [\"SWL @ 3 m\", \"480 kg/m\"], [\"SWL @ 4.5 m\", \"213 kg/m\"], [\"SWL @ 6 m\", \"120 kg/m\"], [\"NEMA class\", \"20B\"], [\"Standard\", \"NEMA VE1-2009\"]] },\n    { id: \"aml150\", system: \"aml\", name: \"Cable ladder AML150\", type: \"Cable ladder\", sys: \"AML150\", image: IMG.aml, code: \"AML150\",\n      chars: [[\"Model\", \"AML150\"], [\"Height\", \"150 mm\"], [\"Loading depth\", \"125 mm\"], [\"SWL @ 3 m\", \"468 kg/m\"], [\"SWL @ 4.5 m\", \"208 kg/m\"], [\"SWL @ 6 m\", \"117 kg/m\"], [\"NEMA class\", \"20B\"], [\"Standard\", \"NEMA VE1-2009\"]] },\n    { id: \"aml-el90\", system: \"aml\", name: \"90° horizontal elbow\", type: \"Flat elbow\", sys: \"AML common\", image: IMG.tee, code: \"AML-EL90\",\n      chars: [[\"Type\", \"Flat elbow\"], [\"Angle\", \"90° horizontal\"], [\"Unit\", \"pc\"], [\"Materials\", \"HDG, SS304, SS316\"]] },\n    { id: \"aml-tee\", system: \"aml\", name: \"Tee piece\", type: \"T-piece\", sys: \"AML common\", image: IMG.tee, code: \"AML-T\",\n      chars: [[\"Type\", \"T-piece\"], [\"Unit\", \"pc\"]] },\n    { id: \"aml-cross\", system: \"aml\", name: \"Equal cross\", type: \"Crosspiece\", sys: \"AML common\", image: IMG.cross, code: \"AML-X\",\n      chars: [[\"Type\", \"Crosspiece\"], [\"Unit\", \"pc\"]] },\n    { id: \"aml-riser-in\", system: \"aml\", name: \"Inside riser 90°\", type: \"Riser\", sys: \"AML common\", image: IMG.riser, code: \"AML-IR\",\n      chars: [[\"Type\", \"Riser\"], [\"Angle\", \"90° inside\"], [\"Unit\", \"pc\"]] },\n    { id: \"aml-riser-out\", system: \"aml\", name: \"Outside riser 90°\", type: \"Riser\", sys: \"AML common\", image: IMG.outside, code: \"AML-OR\",\n      chars: [[\"Type\", \"Riser\"], [\"Angle\", \"90° outside\"], [\"Unit\", \"pc\"]] },\n    { id: \"aml-reducer\", system: \"aml\", name: \"Left / right reducer\", type: \"Reducer\", sys: \"AML common\", image: IMG.reducer, code: \"AML-R\",\n      chars: [[\"Type\", \"Reducer\"], [\"Unit\", \"pc\"]] },\n    { id: \"aml-splice\", system: \"aml\", name: \"Straight splice plate\", type: \"Splice connector\", sys: \"AML common\", image: IMG.body, code: \"SP\",\n      chars: [[\"Type\", \"Splice connector\"], [\"Use\", \"Join straight sections\"], [\"Unit\", \"pc\"]] },\n    { id: \"aml-cover\", system: \"aml\", name: \"Cover for straight ladder\", type: \"Cover\", sys: \"AML common\", image: IMG.body, code: \"LC\",\n      chars: [[\"Type\", \"Cover\"], [\"Lengths\", \"1.5 m, 3 m\"], [\"Unit\", \"m\"]] },\n    { id: \"aml-clip\", system: \"aml\", name: \"Cover clamp\", type: \"Cover clamp\", sys: \"AML common\", image: IMG.body, code: \"CCA\",\n      chars: [[\"Type\", \"Cover clamp\"], [\"Unit\", \"pc\"]] },\n\n    /* APO */\n    { id: \"apo-str\", system: \"apo\", name: \"Cable ladder straight section\", type: \"Cable ladder\", sys: \"APO\", image: IMG.apo, code: \"APO-STR\",\n      chars: [[\"Series\", \"APO\"], [\"Standard\", \"SIRIM / NEMA VE1-2009\"], [\"Safety factor\", \"×1.5\"], [\"Lengths\", \"3 m, 6 m\"]] },\n    { id: \"apo100\", system: \"apo\", name: \"Cable ladder APO100\", type: \"Cable ladder\", sys: \"APO100\", image: IMG.apo, code: \"APO100\",\n      chars: [[\"Model\", \"APO100\"], [\"Loading depth\", \"75 mm\"], [\"SWL @ 3 m\", \"192 kg/m\"], [\"SWL @ 4.5 m\", \"85 kg/m\"], [\"SWL @ 6 m\", \"48 kg/m\"], [\"NEMA class\", \"20AA\"]] },\n    { id: \"apo125\", system: \"apo\", name: \"Cable ladder APO125\", type: \"Cable ladder\", sys: \"APO125\", image: IMG.apo, code: \"APO125\",\n      chars: [[\"Model\", \"APO125\"], [\"Loading depth\", \"100 mm\"], [\"SWL @ 3 m\", \"416 kg/m\"], [\"SWL @ 4.5 m\", \"185 kg/m\"], [\"SWL @ 6 m\", \"104 kg/m\"], [\"NEMA class\", \"20A\"]] },\n    { id: \"apo150\", system: \"apo\", name: \"Cable ladder APO150\", type: \"Cable ladder\", sys: \"APO150\", image: IMG.apo, code: \"APO150\",\n      chars: [[\"Model\", \"APO150\"], [\"Loading depth\", \"125 mm\"], [\"SWL @ 3 m\", \"540 kg/m\"], [\"SWL @ 4.5 m\", \"240 kg/m\"], [\"SWL @ 6 m\", \"135 kg/m\"], [\"NEMA class\", \"20B\"]] },\n    { id: \"apo-el90\", system: \"apo\", name: \"90° horizontal elbow\", type: \"Flat elbow\", sys: \"APO common\", image: IMG.tee, code: \"APO-EL90\",\n      chars: [[\"Type\", \"Flat elbow\"], [\"Unit\", \"pc\"]] },\n    { id: \"apo-splice\", system: \"apo\", name: \"Straight splice plate\", type: \"Splice connector\", sys: \"APO common\", image: IMG.body, code: \"APO-SP\",\n      chars: [[\"Type\", \"Splice connector\"], [\"Unit\", \"pc\"]] },\n    { id: \"apo-cover\", system: \"apo\", name: \"Cover for straight ladder\", type: \"Cover\", sys: \"APO common\", image: IMG.body, code: \"APO-LC\",\n      chars: [[\"Type\", \"Cover\"], [\"Unit\", \"m\"]] },\n\n    /* ACD */\n    { id: \"acd-str\", system: \"acd\", name: \"Cable ladder straight section\", type: \"Cable ladder\", sys: \"ACD\", image: IMG.acd, code: \"ACD-STR\",\n      chars: [[\"Series\", \"ACD\"], [\"Standard\", \"IEC 61537:2006\"], [\"Safety factor\", \"×1.7\"], [\"Certificate\", \"2018MA0594-ACD-IEC61537\"]] },\n    { id: \"acd100\", system: \"acd\", name: \"Cable ladder ACD100\", type: \"Cable ladder\", sys: \"ACD100\", image: IMG.acd, code: \"ACD100\",\n      chars: [[\"Model\", \"ACD100\"], [\"Loading depth\", \"75 mm\"], [\"SWL @ 3 m\", \"239 kg/m\"], [\"SWL @ 4.5 m\", \"106 kg/m\"], [\"SWL @ 6 m\", \"60 kg/m\"], [\"Standard\", \"IEC 61537\"]] },\n    { id: \"acd125\", system: \"acd\", name: \"Cable ladder ACD125\", type: \"Cable ladder\", sys: \"ACD125\", image: IMG.acd, code: \"ACD125\",\n      chars: [[\"Model\", \"ACD125\"], [\"Loading depth\", \"100 mm\"], [\"SWL @ 3 m\", \"560 kg/m\"], [\"SWL @ 4.5 m\", \"249 kg/m\"], [\"SWL @ 6 m\", \"140 kg/m\"]] },\n    { id: \"acd150\", system: \"acd\", name: \"Cable ladder ACD150\", type: \"Cable ladder\", sys: \"ACD150\", image: IMG.acd, code: \"ACD150\",\n      chars: [[\"Model\", \"ACD150\"], [\"Loading depth\", \"125 mm\"], [\"SWL @ 3 m\", \"579 kg/m\"], [\"SWL @ 4.5 m\", \"257 kg/m\"], [\"SWL @ 6 m\", \"145 kg/m\"]] },\n    { id: \"acd-el90\", system: \"acd\", name: \"90° horizontal elbow\", type: \"Flat elbow\", sys: \"ACD common\", image: IMG.tee, code: \"ACD-EL90\",\n      chars: [[\"Type\", \"Flat elbow\"], [\"Unit\", \"pc\"]] },\n    { id: \"acd-splice\", system: \"acd\", name: \"Straight splice plate\", type: \"Splice connector\", sys: \"ACD common\", image: IMG.body, code: \"ACD-SP\",\n      chars: [[\"Type\", \"Splice connector\"], [\"Unit\", \"pc\"]] },\n\n    /* ART / AMT trays */\n    { id: \"art50\", system: \"art\", name: \"Cable tray ART50\", type: \"Cable tray\", sys: \"ART50\", image: IMG.art, code: \"ART50\",\n      chars: [[\"Model\", \"ART50\"], [\"Height\", \"50 mm\"], [\"SWL @ 1.5 m\", \"484 kg/m\"], [\"SWL @ 2 m\", \"272 kg/m\"], [\"SWL @ 3 m\", \"121 kg/m\"], [\"NEMA class\", \"20AA\"]] },\n    { id: \"art-cover\", system: \"art\", name: \"Cover for cable tray\", type: \"Cover\", sys: \"ART common\", image: IMG.tray, code: \"ART-LC\",\n      chars: [[\"Type\", \"Cover\"], [\"Unit\", \"m\"]] },\n    { id: \"art-splice\", system: \"art\", name: \"Splice plate\", type: \"Splice connector\", sys: \"ART common\", image: IMG.tray, code: \"ART-SP\",\n      chars: [[\"Type\", \"Splice connector\"], [\"Unit\", \"pc\"]] },\n    { id: \"amt100\", system: \"amt\", name: \"Cable tray AMT100\", type: \"Cable tray\", sys: \"AMT100\", image: IMG.tray, code: \"AMT100\",\n      chars: [[\"Model\", \"AMT100\"], [\"Height\", \"100 mm\"], [\"SWL @ 1.5 m\", \"716 kg/m\"], [\"SWL @ 2 m\", \"403 kg/m\"], [\"SWL @ 3 m\", \"179 kg/m\"], [\"NEMA class\", \"20B\"]] },\n    { id: \"amt-cover\", system: \"amt\", name: \"Cover for cable tray\", type: \"Cover\", sys: \"AMT common\", image: IMG.tray, code: \"AMT-LC\",\n      chars: [[\"Type\", \"Cover\"], [\"Unit\", \"m\"]] },\n    { id: \"amt-elbow\", system: \"amt\", name: \"90° elbow tray\", type: \"Flat elbow\", sys: \"AMT common\", image: IMG.tray, code: \"AMT-EL90\",\n      chars: [[\"Type\", \"Flat elbow\"], [\"Unit\", \"pc\"]] }\n  ];\n\n  /* ========== STATE ========== */\n  const state = {\n    filters: { systems: new Set(), types: new Set(), q: \"\" }\n  };\n\n  function esc(s) {\n    return String(s ?? \"\")\n      .replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\")\n      .replace(/>/g, \"&gt;\").replace(/\"/g, \"&quot;\");\n  }\n\n  function groupById(id) { return GROUPS.find((g) => g.id === id); }\n  function articlesForSystem(sysId) { return ARTICLES.filter((a) => a.system === sysId); }\n  function articlesForGroup(groupId) {\n    const sysIds = groupById(groupId)?.systems || [];\n    return ARTICLES.filter((a) => sysIds.includes(a.system));\n  }\n\n  /* ========== ROUTER ========== */\n  function parseHash() {\n    const h = (location.hash || \"#/\").replace(/^#\\/?/, \"\");\n    const parts = h.split(\"/\").filter(Boolean);\n    if (!parts.length) return { page: \"home\" };\n    if (parts[0] === \"article\" && parts[1]) return { page: \"article\", id: parts[1] };\n    if (parts[0] === \"system\" && parts[1]) return { page: \"system\", id: parts[1] };\n    if (groupById(parts[0])) return { page: \"group\", id: parts[0] };\n    return { page: \"home\" };\n  }\n\n  function go(path) {\n    location.hash = \"#/\" + path.replace(/^\\//, \"\");\n  }\n\n  function setNav(active) {\n    document.querySelectorAll(\".top-nav a\").forEach((a) => {\n      const r = a.getAttribute(\"data-route\");\n      a.classList.toggle(\"is-active\", r === active || (active === \"group\" && r === active));\n    });\n  }\n\n  /* ========== RENDERERS ========== */\n  function renderHome() {\n    setNav(\"home\");\n    return `\n      <div class=\"breadcrumb\"><span>Products</span></div>\n      <h1 class=\"page-title\">Products</h1>\n      <p class=\"page-intro\">Browse Array Metal cable support systems and engineered products. Select a product group to explore systems, components and technical data.</p>\n      <div class=\"group-grid\">\n        ${GROUPS.map((g) => `\n          <button type=\"button\" class=\"group-card\" data-go=\"group/${g.id}\">\n            <div class=\"thumb\"><img src=\"${esc(g.image)}\" alt=\"\" loading=\"lazy\" /></div>\n            <div class=\"body\">\n              <div class=\"meta\">${esc(g.category)}</div>\n              <h2>${esc(g.name)}</h2>\n              <p>${esc(g.blurb)}</p>\n            </div>\n          </button>\n        `).join(\"\")}\n      </div>\n    `;\n  }\n\n  function renderGroup(groupId) {\n    const g = groupById(groupId);\n    if (!g) return renderHome();\n    setNav(groupId === \"cable-ladders\" || groupId === \"cable-trays\" ? groupId : \"home\");\n\n    if (!g.systems.length) {\n      return `\n        <div class=\"breadcrumb\">\n          <a href=\"#/\" data-go=\"home\">Products</a> / <span>${esc(g.name)}</span>\n        </div>\n        <h1 class=\"page-title\">${esc(g.name)}</h1>\n        <p class=\"page-intro\">${esc(g.blurb)}</p>\n        <div class=\"empty-state\">System pages for this group will be expanded next — structure matches Cable Ladders / Cable Trays.</div>\n      `;\n    }\n\n    const systems = g.systems.map((id) => SYSTEMS[id]).filter(Boolean);\n    return `\n      <div class=\"breadcrumb\">\n        <a href=\"#/\" data-go=\"home\">Products</a> / <span>${esc(g.name)}</span>\n      </div>\n      <h1 class=\"page-title\">${esc(g.name)}</h1>\n      <p class=\"page-intro\">${esc(g.blurb)}</p>\n      <div class=\"system-list\">\n        ${systems.map((s) => `\n          <button type=\"button\" class=\"system-card\" data-go=\"system/${s.id}\">\n            <div class=\"thumb\"><img src=\"${esc(s.image)}\" alt=\"\" loading=\"lazy\" /></div>\n            <div class=\"body\">\n              <h2>${esc(s.name)}</h2>\n              <p>${esc(s.short)}</p>\n              <div class=\"tags\">\n                <span class=\"pill\">${esc(s.standard)}</span>\n                <span class=\"pill\">SF ${esc(s.safety)}</span>\n              </div>\n            </div>\n          </button>\n        `).join(\"\")}\n      </div>\n    `;\n  }\n\n  function filterArticles(list) {\n    const { systems, types, q } = state.filters;\n    return list.filter((a) => {\n      if (systems.size && !systems.has(a.sys)) return false;\n      if (types.size && !types.has(a.type)) return false;\n      if (q) {\n        const hay = (a.name + \" \" + a.code + \" \" + a.type + \" \" + a.sys).toLowerCase();\n        if (!hay.includes(q.toLowerCase())) return false;\n      }\n      return true;\n    });\n  }\n\n  function countBy(list, key) {\n    const m = {};\n    list.forEach((a) => { m[a[key]] = (m[a[key]] || 0) + 1; });\n    return m;\n  }\n\n  function renderSystem(sysId) {\n    const s = SYSTEMS[sysId];\n    if (!s) return renderHome();\n    const g = groupById(s.group);\n    setNav(s.group);\n\n    const all = articlesForSystem(sysId);\n    const filtered = filterArticles(all);\n    const bySys = countBy(all, \"sys\");\n    const byType = countBy(all, \"type\");\n    const sysKeys = Object.keys(bySys).sort();\n    const typeKeys = Object.keys(byType).sort();\n    const hasFilters = state.filters.systems.size || state.filters.types.size || state.filters.q;\n\n    return `\n      <div class=\"breadcrumb\">\n        <a href=\"#/\" data-go=\"home\">Products</a> /\n        <a href=\"#/${esc(s.group)}\" data-go=\"group/${esc(s.group)}\">${esc(g?.name || s.group)}</a> /\n        <span>${esc(s.name)}</span>\n      </div>\n      <h1 class=\"page-title\">${esc(s.name)}</h1>\n      <p class=\"page-intro\">${esc(s.overview)}</p>\n\n      <div class=\"system-layout\">\n        <aside class=\"filter-panel\">\n          <div class=\"filter-head\">\n            <h3>Filter products</h3>\n            <button type=\"button\" class=\"filter-clear\" id=\"clear-filters\" ${hasFilters ? \"\" : \"disabled\"}>Clear all</button>\n          </div>\n          <div class=\"filter-section\">\n            <h4>System</h4>\n            ${sysKeys.map((k) => `\n              <label class=\"filter-option\">\n                <input type=\"checkbox\" data-filter=\"sys\" value=\"${esc(k)}\" ${state.filters.systems.has(k) ? \"checked\" : \"\"} />\n                <span>${esc(k)}</span>\n                <span class=\"count\">(${bySys[k]})</span>\n              </label>\n            `).join(\"\")}\n          </div>\n          <div class=\"filter-section\">\n            <h4>Product type</h4>\n            ${typeKeys.map((k) => `\n              <label class=\"filter-option\">\n                <input type=\"checkbox\" data-filter=\"type\" value=\"${esc(k)}\" ${state.filters.types.has(k) ? \"checked\" : \"\"} />\n                <span>${esc(k)}</span>\n                <span class=\"count\">(${byType[k]})</span>\n              </label>\n            `).join(\"\")}\n          </div>\n          <div class=\"filter-section\">\n            <h4>Search</h4>\n            <input class=\"filter-search\" id=\"filter-q\" type=\"search\" placeholder=\"Name or code…\" value=\"${esc(state.filters.q)}\" />\n          </div>\n        </aside>\n\n        <div>\n          <div class=\"results-bar\">\n            <div class=\"count\"><strong>${filtered.length}</strong> results</div>\n            <div class=\"active-filters\" id=\"active-filters\">\n              ${[...state.filters.systems].map((k) => `<span class=\"chip\">${esc(k)} <button type=\"button\" data-remove-sys=\"${esc(k)}\" aria-label=\"Remove\">×</button></span>`).join(\"\")}\n              ${[...state.filters.types].map((k) => `<span class=\"chip\">${esc(k)} <button type=\"button\" data-remove-type=\"${esc(k)}\" aria-label=\"Remove\">×</button></span>`).join(\"\")}\n              ${state.filters.q ? `<span class=\"chip\">“${esc(state.filters.q)}” <button type=\"button\" data-remove-q aria-label=\"Remove\">×</button></span>` : \"\"}\n            </div>\n          </div>\n\n          ${filtered.length ? `\n            <div class=\"article-grid\">\n              ${filtered.map((a) => `\n                <button type=\"button\" class=\"article-card\" data-go=\"article/${a.id}\">\n                  <div class=\"thumb\"><img src=\"${esc(a.image)}\" alt=\"\" loading=\"lazy\" /></div>\n                  <div class=\"body\">\n                    <h3>${esc(a.name)}</h3>\n                    <p class=\"sub\">${esc(a.code)} · ${esc(a.type)}</p>\n                  </div>\n                </button>\n              `).join(\"\")}\n            </div>\n          ` : `<div class=\"empty-state\">No products match these filters.</div>`}\n\n          <div class=\"content-block\">\n            <h2>System overview</h2>\n            <p>${esc(s.overview)}</p>\n            <div class=\"link-row\">\n              <span class=\"pill\">${esc(s.standard)}</span>\n              <span class=\"pill\">Safety factor ${esc(s.safety)}</span>\n              <span class=\"pill\">Heights ${esc(s.heights)}</span>\n              <span class=\"pill\">Widths ${esc(s.widths)}</span>\n            </div>\n          </div>\n\n          <div class=\"content-block\">\n            <h2>Design details</h2>\n            <div class=\"design-grid\">\n              ${s.design.map((d) => `\n                <div class=\"design-item\">\n                  <h3>${esc(d.t)}</h3>\n                  <p>${esc(d.d)}</p>\n                </div>\n              `).join(\"\")}\n            </div>\n          </div>\n\n          <div class=\"content-block\">\n            <h2>Materials</h2>\n            <div class=\"link-row\">\n              ${s.materials.map((m) => `<a class=\"link-pill\" href=\"https://www.arraymetal.com/materials\" target=\"_blank\" rel=\"noopener\">${esc(m)}</a>`).join(\"\")}\n            </div>\n          </div>\n\n          <div class=\"content-block\">\n            <h2>Downloads & load data</h2>\n            <div class=\"link-row\">\n              <a class=\"link-pill is-primary\" href=\"https://www.arraymetal.com/load-ratings\" target=\"_blank\" rel=\"noopener\">Load ratings (SWL tables)</a>\n              <a class=\"link-pill\" href=\"https://www.arraymetal.com/catalogue\" target=\"_blank\" rel=\"noopener\">Catalogues</a>\n            </div>\n          </div>\n        </div>\n      </div>\n    `;\n  }\n\n  function renderArticle(id) {\n    const a = ARTICLES.find((x) => x.id === id);\n    if (!a) return renderHome();\n    const s = SYSTEMS[a.system];\n    const g = groupById(s.group);\n    setNav(s.group);\n    const related = ARTICLES.filter((x) => x.system === a.system && x.id !== a.id).slice(0, 4);\n\n    return `\n      <div class=\"breadcrumb\">\n        <a href=\"#/\" data-go=\"home\">Products</a> /\n        <a href=\"#/${esc(s.group)}\" data-go=\"group/${esc(s.group)}\">${esc(g?.name)}</a> /\n        <a href=\"#/system/${esc(s.id)}\" data-go=\"system/${esc(s.id)}\">${esc(s.name)}</a> /\n        <span>${esc(a.name)}</span>\n      </div>\n      <h1 class=\"page-title\">${esc(a.name)}</h1>\n\n      <div class=\"article-layout\">\n        <div>\n          <div class=\"article-media\">\n            <img src=\"${esc(a.image)}\" alt=\"${esc(a.name)}\" />\n          </div>\n        </div>\n        <div>\n          <div class=\"article-meta\">\n            <span>${esc(a.code)}</span>\n            <span>${esc(a.type)}</span>\n            <span>${esc(a.sys)}</span>\n          </div>\n          <p style=\"margin:0 0 8px;color:var(--body)\">${esc(s.short)}</p>\n\n          <div class=\"section-label\">Characteristics</div>\n          <table class=\"char-table\">\n            <tbody>\n              ${a.chars.map(([k, v]) => `<tr><th>${esc(k)}</th><td>${esc(v)}</td></tr>`).join(\"\")}\n            </tbody>\n          </table>\n\n          <div class=\"link-row\" style=\"margin-top:20px\">\n            <a class=\"link-pill is-primary\" href=\"https://www.arraymetal.com/load-ratings\" target=\"_blank\" rel=\"noopener\">Load ratings</a>\n            <a class=\"link-pill\" href=\"https://www.arraymetal.com/contact-us\" target=\"_blank\" rel=\"noopener\">Contact sales</a>\n            <button type=\"button\" class=\"link-pill\" data-go=\"system/${esc(s.id)}\">Back to ${esc(s.name)}</button>\n          </div>\n\n          <div class=\"variant-note\">\n            Configure length, width and finish when requesting a quote (Phase 2 inquiry list). This page is technical reference only.\n          </div>\n        </div>\n      </div>\n\n      ${related.length ? `\n        <div class=\"content-block\">\n          <h2>Related products</h2>\n          <div class=\"related-grid\">\n            ${related.map((r) => `\n              <button type=\"button\" class=\"article-card\" data-go=\"article/${r.id}\">\n                <div class=\"thumb\"><img src=\"${esc(r.image)}\" alt=\"\" loading=\"lazy\" /></div>\n                <div class=\"body\">\n                  <h3>${esc(r.name)}</h3>\n                  <p class=\"sub\">${esc(r.code)}</p>\n                </div>\n              </button>\n            `).join(\"\")}\n          </div>\n        </div>\n      ` : \"\"}\n    `;\n  }\n\n  /* ========== MOUNT ========== */\n  const app = document.getElementById(\"app\");\n\n  function render() {\n    const route = parseHash();\n    if (route.page === \"system\" || route.page === \"group\") {\n      /* keep filters when staying in same system; reset when changing system */\n    }\n    if (route.page === \"home\") {\n      state.filters = { systems: new Set(), types: new Set(), q: \"\" };\n      app.innerHTML = renderHome();\n    } else if (route.page === \"group\") {\n      state.filters = { systems: new Set(), types: new Set(), q: \"\" };\n      app.innerHTML = renderGroup(route.id);\n    } else if (route.page === \"system\") {\n      app.innerHTML = renderSystem(route.id);\n      bindSystemFilters(route.id);\n    } else if (route.page === \"article\") {\n      app.innerHTML = renderArticle(route.id);\n    } else {\n      app.innerHTML = renderHome();\n    }\n    bindNav();\n    window.scrollTo(0, 0);\n  }\n\n  function bindNav() {\n    app.querySelectorAll(\"[data-go]\").forEach((el) => {\n      el.addEventListener(\"click\", (e) => {\n        e.preventDefault();\n        const path = el.getAttribute(\"data-go\");\n        if (path === \"home\") go(\"\");\n        else go(path);\n      });\n    });\n  }\n\n  function bindSystemFilters(sysId) {\n    app.querySelectorAll('input[data-filter=\"sys\"]').forEach((input) => {\n      input.addEventListener(\"change\", () => {\n        if (input.checked) state.filters.systems.add(input.value);\n        else state.filters.systems.delete(input.value);\n        app.innerHTML = renderSystem(sysId);\n        bindSystemFilters(sysId);\n        bindNav();\n      });\n    });\n    app.querySelectorAll('input[data-filter=\"type\"]').forEach((input) => {\n      input.addEventListener(\"change\", () => {\n        if (input.checked) state.filters.types.add(input.value);\n        else state.filters.types.delete(input.value);\n        app.innerHTML = renderSystem(sysId);\n        bindSystemFilters(sysId);\n        bindNav();\n      });\n    });\n    const q = document.getElementById(\"filter-q\");\n    if (q) {\n      q.addEventListener(\"input\", () => {\n        state.filters.q = q.value;\n        /* debounce-ish: re-render on input is fine for demo size */\n        const pos = q.selectionStart;\n        app.innerHTML = renderSystem(sysId);\n        bindSystemFilters(sysId);\n        bindNav();\n        const nq = document.getElementById(\"filter-q\");\n        if (nq) { nq.focus(); nq.setSelectionRange(pos, pos); }\n      });\n    }\n    document.getElementById(\"clear-filters\")?.addEventListener(\"click\", () => {\n      state.filters = { systems: new Set(), types: new Set(), q: \"\" };\n      app.innerHTML = renderSystem(sysId);\n      bindSystemFilters(sysId);\n      bindNav();\n    });\n    app.querySelectorAll(\"[data-remove-sys]\").forEach((btn) => {\n      btn.addEventListener(\"click\", () => {\n        state.filters.systems.delete(btn.getAttribute(\"data-remove-sys\"));\n        app.innerHTML = renderSystem(sysId);\n        bindSystemFilters(sysId);\n        bindNav();\n      });\n    });\n    app.querySelectorAll(\"[data-remove-type]\").forEach((btn) => {\n      btn.addEventListener(\"click\", () => {\n        state.filters.types.delete(btn.getAttribute(\"data-remove-type\"));\n        app.innerHTML = renderSystem(sysId);\n        bindSystemFilters(sysId);\n        bindNav();\n      });\n    });\n    app.querySelectorAll(\"[data-remove-q]\").forEach((btn) => {\n      btn.addEventListener(\"click\", () => {\n        state.filters.q = \"\";\n        app.innerHTML = renderSystem(sysId);\n        bindSystemFilters(sysId);\n        bindNav();\n      });\n    });\n  }\n\n  window.addEventListener(\"hashchange\", render);\n  document.querySelectorAll(\".top-nav a, .brand\").forEach((a) => {\n    a.addEventListener(\"click\", (e) => {\n      const route = a.getAttribute(\"data-route\");\n      if (!route) return;\n      e.preventDefault();\n      if (route === \"home\") go(\"\");\n      else go(route);\n    });\n  });\n\n  render();\n})();\n</script>"}