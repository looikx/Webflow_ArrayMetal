generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─── Product Categories ───────────────────────────────────────────

model ProductCategory {
  id          String  @id
  displayName String
  finish      Finish
  description String?
  isActive    Boolean @default(true)

  items            Item[]
  templates        ProductTemplate[]
  categorySettings CategorySetting[]
  auditLogs        AuditLog[]

  @@map("product_categories")
}

// ─── ART NO Block Registry ────────────────────────────────────────

model ArtNoBlock {
  id            Int    @id @default(autoincrement())
  blockPrefix   String @unique
  productFamily String
  categoryId    String
  lastArtNo     Int
  maxArtNo      Int

  @@map("art_no_blocks")
}

// ─── Items (SKUs) ─────────────────────────────────────────────────

model Item {
  id          Int        @id @default(autoincrement())
  partNumber  String     @unique
  artNo       Int        @unique
  description String
  categoryId  String
  series      String
  productType String
  widthMm     Float?
  heightMm    Float?
  thicknessMm Float
  lengthM     Float?
  radiusMm    Float?
  gradeCode   String
  source      ItemSource @default(IMPORTED)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  category ProductCategory @relation(fields: [categoryId], references: [id])
  prices   PriceRecord[]

  @@index([categoryId])
  @@index([series])
  @@index([productType])
  @@index([categoryId, series, productType])
  @@map("items")
}

// ─── Material Prices (shared per finish — material rates only) ────

model MaterialPrice {
  id          Int      @id @default(autoincrement())
  finish      String
  key         String
  displayName String
  value       Float
  unit        String
  sortOrder   Int      @default(0)
  updatedAt   DateTime @updatedAt

  auditLogs AuditLog[]

  @@unique([finish, key])
  @@map("material_prices")
}

// ─── Category Settings (galv + markup per product category) ──────

model CategorySetting {
  id          Int      @id @default(autoincrement())
  categoryId  String
  key         String
  displayName String
  value       Float
  unit        String
  sortOrder   Int      @default(0)
  updatedAt   DateTime @updatedAt

  category  ProductCategory @relation(fields: [categoryId], references: [id])
  auditLogs AuditLog[]

  @@unique([categoryId, key])
  @@map("category_settings")
}

// ─── Price Records ────────────────────────────────────────────────

model PriceRecord {
  id             Int      @id @default(autoincrement())
  itemId         Int
  weightKg       Float
  materialCost   Float
  galvCost       Float
  labourCost     Float
  totalCost      Float
  markupPct      Float
  unitPrice      Float
  pricesSnapshot Json
  isCurrent      Boolean  @default(true)
  calculatedAt   DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id])

  @@index([itemId, isCurrent])
  @@map("price_records")
}

// ─── Product Templates (Phase 3) ─────────────────────────────────

model ProductTemplate {
  id             Int      @id @default(autoincrement())
  categoryId     String
  series         String
  productType    String
  allowedWidths  Float[]
  allowedHeights Float[]
  allowedThick   Float[]
  allowedLengths Float[]
  allowedRadii   Float[]
  gradeCode      String
  isActive       Boolean  @default(true)
  updatedAt      DateTime @updatedAt

  category ProductCategory @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, series, productType])
  @@map("product_templates")
}

// ─── Job Records ─────────────────────────────────────────────────

model JobRecord {
  id          Int       @id @default(autoincrement())
  type        JobType
  status      JobStatus @default(QUEUED)
  categoryId  String?
  payload     Json?
  progress    Int       @default(0)
  totalItems  Int?
  processed   Int       @default(0)
  resultMsg   String?
  errorMsg    String?
  downloadUrl String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@map("job_records")
}

// ─── Audit Log ───────────────────────────────────────────────────

model AuditLog {
  id                Int         @id @default(autoincrement())
  categoryId        String?
  priceId           Int?
  categorySettingId Int?
  action            AuditAction
  entityType        String?
  entityId          String?
  field             String?
  oldValue          String?
  newValue          String?
  description       String?
  createdAt         DateTime    @default(now())

  category        ProductCategory? @relation(fields: [categoryId], references: [id])
  price           MaterialPrice?   @relation(fields: [priceId], references: [id])
  categorySetting CategorySetting? @relation(fields: [categorySettingId], references: [id])

  @@index([categoryId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Enums ───────────────────────────────────────────────────────

enum Finish {
  HDG
  SS316
  SS304
  PLAIN
}

enum ItemSource {
  IMPORTED
  CREATED
  GENERATED
}

enum JobType {
  RECALCULATE
  GENERATE_VARIANTS
  EXPORT
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
  CANCELLED
}

enum AuditAction {
  PRICE_UPDATED
  ITEM_CREATED
  ITEM_DEACTIVATED
  RECALCULATE_STARTED
  RECALCULATE_DONE
  VARIANTS_GENERATED
  EXPORT_GENERATED
}
